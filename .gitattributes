# Store and check out LF everywhere, also on Windows. CRLF breaks shell scripts (shebang line)
# and the "---" frontmatter of SKILL.md files.
* text=auto eol=lf

# PowerShell reads CRLF scripts without surprises on Windows PowerShell 5.1.
*.ps1 text eol=crlf

# Never change these.
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.zip binary
*.gz binary
*.pyc binary
